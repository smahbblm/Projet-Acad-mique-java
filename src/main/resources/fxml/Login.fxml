<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.stock.controller.LoginController"
      styleClass="login-container">

    <!-- Panneau gauche - Branding -->
    <VBox styleClass="login-left-panel" alignment="CENTER" spacing="30" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="50" right="50" bottom="50" left="50"/>
        </padding>

        <!-- Logo/Icône -->
        <StackPane styleClass="logo-container">
            <Region styleClass="logo-icon"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="15">
            <Label text="Système de Gestion de Stock" styleClass="brand-title"/>
            <Label text="Solution complète pour gérer vos stocks, commandes et inventaires"
                   styleClass="brand-subtitle" wrapText="true" textAlignment="CENTER" maxWidth="350"/>
        </VBox>

        <VBox alignment="CENTER" spacing="10" styleClass="features-list">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Region styleClass="feature-icon"/>
                <Label text="Gestion des stocks en temps réel" styleClass="feature-text"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Region styleClass="feature-icon"/>
                <Label text="Suivi des commandes et livraisons" styleClass="feature-text"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Region styleClass="feature-icon"/>
                <Label text="Rapports et statistiques détaillés" styleClass="feature-text"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Panneau droit - Formulaire de connexion -->
    <VBox styleClass="login-right-panel" alignment="CENTER" spacing="25" HBox.hgrow="ALWAYS">
        <padding>
            <Insets top="80" right="80" bottom="80" left="80"/>
        </padding>

        <!-- En-tête -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="Bienvenue" styleClass="login-title"/>
            <Label text="Connectez-vous à votre compte" styleClass="login-subtitle"/>
        </VBox>

        <!-- Formulaire -->
        <VBox spacing="20" styleClass="login-form" maxWidth="400">
            <!-- Champ Email -->
            <VBox spacing="8">
                <Label text="Adresse email" styleClass="input-label"/>
                <TextField fx:id="emailField"
                          promptText="exemple@email.com"
                          styleClass="modern-text-field"/>
            </VBox>

            <!-- Champ Mot de passe -->
            <VBox spacing="8">
                <Label text="Mot de passe" styleClass="input-label"/>
                <PasswordField fx:id="passwordField"
                              promptText="Entrez votre mot de passe"
                              styleClass="modern-text-field"/>
            </VBox>

            <!-- Message d'erreur (caché par défaut) -->
            <Label fx:id="errorLabel" styleClass="error-message" visible="false" managed="false"/>

            <!-- Bouton de connexion -->
            <Button fx:id="loginButton"
                   text="Se connecter"
                   styleClass="login-button"
                   maxWidth="Infinity"
                   defaultButton="true"/>

            <!-- Lien mot de passe oublié -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Mot de passe oublié ?" styleClass="link-text"/>
            </HBox>
        </VBox>

        <!-- Footer -->
        <VBox alignment="CENTER" spacing="5" VBox.vgrow="ALWAYS">
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="© 2025 Système de Gestion de Stock" styleClass="footer-text"/>
            <Label text="Tous droits réservés" styleClass="footer-text"/>
        </VBox>
    </VBox>
</HBox>

