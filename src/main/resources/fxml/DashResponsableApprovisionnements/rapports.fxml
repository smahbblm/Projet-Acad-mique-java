<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controller.controllerResponsableApprovisionnements.RapportsController"
            prefWidth="1200.0" prefHeight="800.0">

<left>
    <VBox spacing="20.0" alignment="TOP_LEFT" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Gestion des stocks" style="-fx-font-weight:bold; -fx-font-size:14;"/>
        </HBox>

        <VBox spacing="8">
            <Button fx:id="btnDashboard" text="Tableau de bord" onAction="#goToDashboard"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding:6 10;"/>

            <Label fx:id="lblProduits" text="Produits" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblFournisseurs" text="Fournisseurs" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblCommandes" text="Commandes" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblStock" text="Stock" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            
            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding:6 10; -fx-background-color:#ffffff; -fx-border-radius:6; -fx-background-radius:6;">
                <Label text="Rapports" style="-fx-font-weight:bold;"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:10; -fx-background-color: #ffffff; -fx-background-radius:8;">
            <Label text="👤" style="-fx-font-size: 24;"/>
            <VBox>
                <Label text="Responsable Appro" style="-fx-font-weight:bold;"/>
                <Label text="admin@entreprise.fr" style="-fx-font-size:11; -fx-text-fill:gray;"/>
            </VBox>
        </HBox>
    </VBox>
</left>

<top>
    <HBox style="-fx-padding:10 20; -fx-background-color: #ffffff; -fx-border-color: transparent transparent #e6e6e6 transparent;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text=" " />
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Responsable des Approvisionnements" style="-fx-text-fill: #777777;"/>
    </HBox>
</top>

<center>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding:24;">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Rapports" style="-fx-font-size:28; -fx-font-weight:bold;"/>
                    <Label text="Générez des rapports détaillés sur vos achats et réceptions" style="-fx-text-fill:#666666;"/>
                </VBox>
            </HBox>

            <VBox spacing="20" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:24;">
                <Label text="Paramètres du rapport" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                
                <VBox spacing="15">
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label text="Type de rapport" prefWidth="120"/>
                        <ComboBox fx:id="reportTypeCombo" prefWidth="200"/>
                    </HBox>
                    
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label text="Date de début" prefWidth="120"/>
                        <DatePicker fx:id="startDatePicker" prefWidth="200"/>
                    </HBox>
                    
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label text="Date de fin" prefWidth="120"/>
                        <DatePicker fx:id="endDatePicker" prefWidth="200"/>
                    </HBox>
                </VBox>
                
                <HBox spacing="10">
                    <Button fx:id="btnGenerateReport" text="Générer le rapport" onAction="#generateReport"
                            style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-background-radius:6; -fx-padding:10 20; -fx-cursor:hand;"/>
                    <Button fx:id="btnDownloadPDF" text="Télécharger PDF" onAction="#downloadPDF"
                            style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-background-radius:6; -fx-padding:10 20; -fx-cursor:hand;"/>
                </HBox>
            </VBox>

            <HBox spacing="20">
                <VBox spacing="10" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:20; -fx-pref-width:280;">
                    <Label text="Statistiques" style="-fx-font-size:16; -fx-font-weight:bold;"/>
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Total commandes:" style="-fx-text-fill:#666666;"/>
                            <Label fx:id="lblTotalCommandes" text="24" style="-fx-font-weight:bold;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Montant total:" style="-fx-text-fill:#666666;"/>
                            <Label fx:id="lblMontantTotal" text="18,450 €" style="-fx-font-weight:bold; -fx-text-fill:#2e86de;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Produits actifs:" style="-fx-text-fill:#666666;"/>
                            <Label fx:id="lblProduitsActifs" text="156" style="-fx-font-weight:bold;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Fournisseurs:" style="-fx-text-fill:#666666;"/>
                            <Label fx:id="lblNbFournisseurs" text="8" style="-fx-font-weight:bold;"/>
                        </HBox>
                    </VBox>
                </VBox>

                <VBox spacing="10" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:20;" HBox.hgrow="ALWAYS">
                    <Label text="Derniers rapports générés" style="-fx-font-size:16; -fx-font-weight:bold;"/>
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding:8; -fx-background-color:#f8f9fa; -fx-background-radius:4;">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Rapport achats - Décembre 2024" style="-fx-font-weight:bold;"/>
                                <Label text="Généré le 15/12/2024" style="-fx-font-size:11; -fx-text-fill:#666666;"/>
                            </VBox>
                            <Button text="Télécharger" style="-fx-cursor:hand;"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding:8; -fx-background-color:#f8f9fa; -fx-background-radius:4;">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Analyse stock - Novembre 2024" style="-fx-font-weight:bold;"/>
                                <Label text="Généré le 30/11/2024" style="-fx-font-size:11; -fx-text-fill:#666666;"/>
                            </VBox>
                            <Button text="Télécharger" style="-fx-cursor:hand;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</center>

</BorderPane>