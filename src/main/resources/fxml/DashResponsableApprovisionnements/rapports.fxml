<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controller.controllerResponsableApprovisionnements.RapportsController"
            prefWidth="1200.0" prefHeight="800.0">

<left>
    <VBox spacing="20.0" alignment="TOP_LEFT" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Gestion des stocks" style="-fx-font-weight:bold; -fx-font-size:14;"/>
        </HBox>

        <VBox spacing="8">
            <Label fx:id="lblDashboard" text="Tableau de bord" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblProduits" text="Produits" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblFournisseurs" text="Fournisseurs" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblCommandes" text="Commandes" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblStock" text="Stock" style="-fx-cursor: hand; -fx-padding:6 10;"/>

            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding:6 10; -fx-background-color:#ffffff; -fx-border-radius:6; -fx-background-radius:6;">
                <Label text="Rapports" style="-fx-font-weight:bold;"/>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:10; -fx-background-color: #ffffff; -fx-background-radius:8;">
            <Label text="👤" style="-fx-font-size: 24;"/>
            <VBox>
                <Label text="Responsable Appro" style="-fx-font-weight:bold;"/>
                <Label text="admin@entreprise.fr" style="-fx-font-size:11; -fx-text-fill:gray;"/>
            </VBox>
        </HBox>
    </VBox>
</left>

<top>
    <HBox style="-fx-padding:10 20; -fx-background-color: #ffffff; -fx-border-color: transparent transparent #e6e6e6 transparent;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text=" " />
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Responsable des Approvisionnements" style="-fx-text-fill: #777777;"/>
    </HBox>
</top>

<center>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding:24;">
            <VBox spacing="6">
                <Label text="Rapports" style="-fx-font-size:28; -fx-font-weight:bold;"/>
                <Label text="Téléchargez vos rapports au format CSV" style="-fx-text-fill:#666666;"/>
            </VBox>

            <GridPane hgap="20" vgap="20">
                <!-- Rapport Produits -->
                <VBox spacing="12" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:20;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="📦 Produits" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                    <Label text="Liste complète des produits avec stock, prix et seuils" style="-fx-text-fill:#666666;" wrapText="true"/>
                    <Button text="Télécharger CSV" onAction="#exportProduits" style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-padding:10 20; -fx-background-radius:6; -fx-cursor:hand;"/>
                </VBox>

                <!-- Rapport Fournisseurs -->
                <VBox spacing="12" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:20;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="🏢 Fournisseurs" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                    <Label text="Liste des fournisseurs avec coordonnées complètes" style="-fx-text-fill:#666666;" wrapText="true"/>
                    <Button text="Télécharger CSV" onAction="#exportFournisseurs" style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-padding:10 20; -fx-background-radius:6; -fx-cursor:hand;"/>
                </VBox>

                <!-- Rapport Commandes -->
                <VBox spacing="12" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:20;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="📋 Bons de commande" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                    <Label text="Historique des bons de commande avec statuts" style="-fx-text-fill:#666666;" wrapText="true"/>
                    <Button text="Télécharger CSV" onAction="#exportCommandes" style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-padding:10 20; -fx-background-radius:6; -fx-cursor:hand;"/>
                </VBox>

                <!-- Rapport Mouvements -->
                <VBox spacing="12" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:20;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="📊 Mouvements de stock" style="-fx-font-size:18; -fx-font-weight:bold;"/>
                    <Label text="Historique complet des mouvements de stock" style="-fx-text-fill:#666666;" wrapText="true"/>
                    <Button text="Télécharger CSV" onAction="#exportMouvements" style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-padding:10 20; -fx-background-radius:6; -fx-cursor:hand;"/>
                </VBox>
            </GridPane>
        </VBox>
    </ScrollPane>
</center>
</BorderPane>
