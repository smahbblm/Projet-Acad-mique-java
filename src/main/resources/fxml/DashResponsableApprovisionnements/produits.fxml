<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controller.controllerResponsableApprovisionnements.ProduitsController"
            prefWidth="1200.0" prefHeight="800.0">

<!-- Sidebar -->
<left>
    <VBox spacing="20.0" alignment="TOP_LEFT" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Gestion des stocks" style="-fx-font-weight:bold; -fx-font-size:14;"/>
        </HBox>

        <VBox spacing="8">
            <Button fx:id="btnDashboard" text="Tableau de bord" onAction="#goToDashboard"
                    style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding:6 10;"/>

            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding:6 10; -fx-background-color:#ffffff; -fx-border-radius:6; -fx-background-radius:6;">
                <Label text="Produits" style="-fx-font-weight:bold;"/>
            </HBox>

            <Label fx:id="lblFournisseurs" text="Fournisseurs" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblCommandes" text="Commandes" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblStock" text="Stock" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Button fx:id="btnRapports" text="Rapports" onAction="#goToRapports" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding:6 10; -fx-border-width:0;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- User Info --> <!-- STATIQUE -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:10; -fx-background-color: #ffffff; -fx-background-radius:8;">
            <Label text="👤" style="-fx-font-size: 24;"/>
            <VBox>
                <Label text="Responsable Appro" style="-fx-font-weight:bold;"/>
                <Label text="admin@entreprise.fr" style="-fx-font-size:11; -fx-text-fill:gray;"/>
            </VBox>
        </HBox>
    </VBox>
</left>

<!-- Top bar -->
<top>
    <HBox style="-fx-padding:10 20; -fx-background-color: #ffffff; -fx-border-color: transparent transparent #e6e6e6 transparent;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text=" " />
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Responsable des Approvisionnements" style="-fx-text-fill: #777777;"/>
    </HBox>
</top>

<!-- Main content -->
<center>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding:24;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Produits" style="-fx-font-size:28; -fx-font-weight:bold;"/>
                    <Label text="Gérez votre catalogue de produits" style="-fx-text-fill:#666666;"/>
                </VBox>
                <Button fx:id="btnAddProduct" text="+ Nouveau produit" onAction="#openAddProductPopup"
                        style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-background-radius:6; -fx-padding:10 20; -fx-cursor:hand;"/>
            </HBox>

            <!-- Search bar -->
            <TextField fx:id="searchField" promptText="🔍 Rechercher par nom ou référence..."
                       style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:12;"/>

            <!-- Légende des actions -->
            <HBox spacing="15" style="-fx-background-color:#f9f9f9; -fx-padding:10; -fx-border-radius:6; -fx-background-radius:6;">
                <Label text="Actions:" style="-fx-font-weight:bold;"/>
                <Label text="✏️ Modifier" style="-fx-text-fill:#666;"/>
                <Label text="🗑️ Supprimer" style="-fx-text-fill:#666;"/>
            </HBox>

            <!-- Products table -->
            <VBox spacing="0" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:0;">
                <!-- Table header -->
                <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #e6e6e6 transparent; -fx-border-width:0 0 1 0;">
                    <Label text="Référence" style="-fx-text-fill:#999999; -fx-pref-width:120;"/>
                    <Label text="Nom" style="-fx-text-fill:#999999; -fx-pref-width:180;"/>
                    <Label text="Catégorie" style="-fx-text-fill:#999999; -fx-pref-width:120;"/>
                    <Label text="Prix unitaire" style="-fx-text-fill:#999999; -fx-pref-width:100;"/>
                    <Label text="Stock" style="-fx-text-fill:#999999; -fx-pref-width:80;"/>
                    <Label text="Seuil min" style="-fx-text-fill:#999999; -fx-pref-width:80;"/>
                    <Label text="Statut" style="-fx-text-fill:#999999; -fx-pref-width:120;"/>
                    <Label text="Actions" style="-fx-text-fill:#999999; -fx-pref-width:100;"/>
                </HBox>

                <VBox fx:id="productsContainer" spacing="0">
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</center>
</BorderPane>