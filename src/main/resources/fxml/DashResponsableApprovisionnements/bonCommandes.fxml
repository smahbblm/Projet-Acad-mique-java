<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controller.controllerResponsableApprovisionnements.BonCommandesController"
            prefWidth="1200.0" prefHeight="800.0">

<!-- Sidebar -->
<left>
    <VBox spacing="20.0" alignment="TOP_LEFT" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Gestion des stocks" style="-fx-font-weight:bold; -fx-font-size:14;"/>
        </HBox>

        <VBox spacing="8">
            <Label fx:id="lblDashboard" text="Tableau de bord" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblProduits" text="Produits" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblFournisseurs" text="Fournisseurs" style="-fx-cursor: hand; -fx-padding:6 10;"/>

            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding:6 10; -fx-background-color:#ffffff; -fx-border-radius:6; -fx-background-radius:6;">
                <Label text="Commandes" style="-fx-font-weight:bold;"/>
            </HBox>

            <Label fx:id="lblStock" text="Stock" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblRapports" text="Rapports" style="-fx-cursor: hand; -fx-padding:6 10;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:10; -fx-background-color: #ffffff; -fx-background-radius:8;">
            <Label text="👤" style="-fx-font-size: 24;"/>
            <VBox>
                <Label text="Responsable Appro" style="-fx-font-weight:bold;"/>
                <Label text="admin@entreprise.fr" style="-fx-font-size:11; -fx-text-fill:gray;"/>
            </VBox>
        </HBox>
    </VBox>
</left>

<!-- Top bar -->
<top>
    <HBox style="-fx-padding:10 20; -fx-background-color: #ffffff; -fx-border-color: transparent transparent #e6e6e6 transparent;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text=" " />
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Responsable des Approvisionnements" style="-fx-text-fill: #777777;"/>
    </HBox>
</top>

<!-- Main content -->
<center>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding:24;">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Bons de commande" style="-fx-font-size:28; -fx-font-weight:bold;"/>
                    <Label text="Créez et suivez vos commandes fournisseurs" style="-fx-text-fill:#666666;"/>
                </VBox>
                <Button fx:id="btnAddOrder" text="+ Nouvelle commande" onAction="#openAddOrderPopup"
                        style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-background-radius:6; -fx-padding:10 20; -fx-cursor:hand;"/>
            </HBox>

            <!-- Search bar -->
            <TextField fx:id="searchField" promptText="🔍 Rechercher par numéro ou fournisseur..."
                       style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:12;"/>

            <!-- Orders table -->
            <VBox spacing="0" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:0;">
                <!-- Table header -->
                <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #e6e6e6 transparent; -fx-border-width:0 0 1 0;">
                    <Label text="N° Commande" style="-fx-text-fill:#999999; -fx-pref-width:120;"/>
                    <Label text="Fournisseur" style="-fx-text-fill:#999999; -fx-pref-width:140;"/>
                    <Label text="Date" style="-fx-text-fill:#999999; -fx-pref-width:100;"/>
                    <Label text="Livraison prévue" style="-fx-text-fill:#999999; -fx-pref-width:120;"/>
                    <Label text="Articles" style="-fx-text-fill:#999999; -fx-pref-width:70;"/>
                    <Label text="Montant" style="-fx-text-fill:#999999; -fx-pref-width:100;"/>
                    <Label text="Statut" style="-fx-text-fill:#999999; -fx-pref-width:100;"/>
                    <Label text="Actions" style="-fx-text-fill:#999999; -fx-pref-width:120;"/>
                </HBox>

                <!-- Order rows -->
                <VBox fx:id="ordersContainer" spacing="0">
                    <!-- Row 1 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="CMD-2024-001" style="-fx-pref-width:120;"/>
                        <Label text="Fournitures Pro" style="-fx-pref-width:140;"/>
                        <Label text="📅 15/01/2024" style="-fx-pref-width:100; -fx-font-size:11;"/>
                        <Label text="22/01/2024" style="-fx-pref-width:120;"/>
                        <Label text="5" style="-fx-pref-width:70;"/>
                        <Label text="2 450 €" style="-fx-pref-width:100;"/>
                        <Label text="En cours" style="-fx-background-color:#e8e8e8; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="8" style="-fx-pref-width:120;">
                            <Button text="👁" style="-fx-cursor:hand;"/>
                            <Button text="✏️" onAction="#openEditOrderPopup" style="-fx-cursor:hand;"/>
                            <Button text="🗑️" style="-fx-cursor:hand;"/>
                        </HBox>
                    </HBox>

                    <!-- Row 2 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="CMD-2024-002" style="-fx-pref-width:120;"/>
                        <Label text="Tech Supplies" style="-fx-pref-width:140;"/>
                        <Label text="📅 14/01/2024" style="-fx-pref-width:100; -fx-font-size:11;"/>
                        <Label text="20/01/2024" style="-fx-pref-width:120;"/>
                        <Label text="3" style="-fx-pref-width:70;"/>
                        <Label text="1 280 €" style="-fx-pref-width:100;"/>
                        <Label text="Livrée" style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="8" style="-fx-pref-width:120;">
                            <Button text="👁" style="-fx-cursor:hand;"/>
                            <Button text="✏️" onAction="#openEditOrderPopup" style="-fx-cursor:hand;"/>
                            <Button text="🗑️" style="-fx-cursor:hand;"/>
                        </HBox>
                    </HBox>

                    <!-- Row 3 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="CMD-2024-003" style="-fx-pref-width:120;"/>
                        <Label text="Industrie Plus" style="-fx-pref-width:140;"/>
                        <Label text="📅 13/01/2024" style="-fx-pref-width:100; -fx-font-size:11;"/>
                        <Label text="25/01/2024" style="-fx-pref-width:120;"/>
                        <Label text="8" style="-fx-pref-width:70;"/>
                        <Label text="3 720 €" style="-fx-pref-width:100;"/>
                        <Label text="En cours" style="-fx-background-color:#e8e8e8; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="8" style="-fx-pref-width:120;">
                            <Button text="👁" style="-fx-cursor:hand;"/>
                            <Button text="✏️" onAction="#openEditOrderPopup" style="-fx-cursor:hand;"/>
                            <Button text="🗑️" style="-fx-cursor:hand;"/>
                        </HBox>
                    </HBox>

                    <!-- Row 4 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="CMD-2024-004" style="-fx-pref-width:120;"/>
                        <Label text="Matériel Express" style="-fx-pref-width:140;"/>
                        <Label text="📅 12/01/2024" style="-fx-pref-width:100; -fx-font-size:11;"/>
                        <Label text="18/01/2024" style="-fx-pref-width:120;"/>
                        <Label text="2" style="-fx-pref-width:70;"/>
                        <Label text="890 €" style="-fx-pref-width:100;"/>
                        <Label text="Livrée" style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="8" style="-fx-pref-width:120;">
                            <Button text="👁" style="-fx-cursor:hand;"/>
                            <Button text="✏️" onAction="#openEditOrderPopup" style="-fx-cursor:hand;"/>
                            <Button text="🗑️" style="-fx-cursor:hand;"/>
                        </HBox>
                    </HBox>

                    <!-- Row 5 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="CMD-2024-005" style="-fx-pref-width:120;"/>
                        <Label text="Stock Direct" style="-fx-pref-width:140;"/>
                        <Label text="📅 11/01/2024" style="-fx-pref-width:100; -fx-font-size:11;"/>
                        <Label text="19/01/2024" style="-fx-pref-width:120;"/>
                        <Label text="4" style="-fx-pref-width:70;"/>
                        <Label text="1 560 €" style="-fx-pref-width:100;"/>
                        <Label text="En cours" style="-fx-background-color:#e8e8e8; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="8" style="-fx-pref-width:120;">
                            <Button text="👁" style="-fx-cursor:hand;"/>
                            <Button text="✏️" onAction="#openEditOrderPopup" style="-fx-cursor:hand;"/>
                            <Button text="🗑️" style="-fx-cursor:hand;"/>
                        </HBox>
                    </HBox>

                    <!-- Row 6 -->
                    <HBox spacing="10" style="-fx-padding:16;">
                        <Label text="CMD-2024-006" style="-fx-pref-width:120;"/>
                        <Label text="Fournitures Pro" style="-fx-pref-width:140;"/>
                        <Label text="📅 10/01/2024" style="-fx-pref-width:100; -fx-font-size:11;"/>
                        <Label text="-" style="-fx-pref-width:120;"/>
                        <Label text="6" style="-fx-pref-width:70;"/>
                        <Label text="2 100 €" style="-fx-pref-width:100;"/>
                        <Label text="Annulée" style="-fx-background-color:#f0f0f0; -fx-text-fill:#666666; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="8" style="-fx-pref-width:120;">
                            <Button text="👁" style="-fx-cursor:hand;"/>
                            <Button text="✏️" onAction="#openEditOrderPopup" style="-fx-cursor:hand;"/>
                            <Button text="🗑️" style="-fx-cursor:hand;"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</center>
</BorderPane>
