<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controller.controllerResponsableApprovisionnements.MouvementsStockController"
            prefWidth="1200.0" prefHeight="800.0">

<!-- Sidebar -->
<left>
    <VBox spacing="20.0" alignment="TOP_LEFT" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Gestion des stocks" style="-fx-font-weight:bold; -fx-font-size:14;"/>
        </HBox>

        <VBox spacing="8">
            <Label fx:id="lblDashboard" text="Tableau de bord" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblProduits" text="Produits" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblFournisseurs" text="Fournisseurs" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblCommandes" text="Commandes" style="-fx-cursor: hand; -fx-padding:6 10;"/>

            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding:6 10; -fx-background-color:#ffffff; -fx-border-radius:6; -fx-background-radius:6;">
                <Label text="Stock" style="-fx-font-weight:bold;"/>
            </HBox>

            <Label text="Rapports" style="-fx-cursor: hand; -fx-padding:6 10;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:10; -fx-background-color: #ffffff; -fx-background-radius:8;">
            <Label text="👤" style="-fx-font-size: 24;"/>
            <VBox>
                <Label text="Responsable Appro" style="-fx-font-weight:bold;"/>
                <Label text="admin@entreprise.fr" style="-fx-font-size:11; -fx-text-fill:gray;"/>
            </VBox>
        </HBox>
    </VBox>
</left>

<!-- Top bar -->
<top>
    <HBox style="-fx-padding:10 20; -fx-background-color: #ffffff; -fx-border-color: transparent transparent #e6e6e6 transparent;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text=" " />
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Responsable des Approvisionnements" style="-fx-text-fill: #777777;"/>
    </HBox>
</top>

<!-- Main content -->
<center>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding:24;">
            <!-- Header -->
            <VBox spacing="6">
                <Label text="Gestion du Stock" style="-fx-font-size:28; -fx-font-weight:bold;"/>
                <Label text="Consultez l'état de vos stocks et suivez les mouvements" style="-fx-text-fill:#666666;"/>
            </VBox>

            <!-- Tabs -->
            <HBox spacing="10">
                <Button fx:id="btnInventaire" text="Inventaire" onAction="#goToInventaire" style="-fx-background-color:transparent; -fx-padding:8 16; -fx-background-radius:6; -fx-cursor:hand;"/>
                <Button text="Mouvements de stock" style="-fx-background-color:#ffffff; -fx-padding:8 16; -fx-background-radius:6; -fx-border-color:#2e86de; -fx-border-radius:6; -fx-font-weight:bold;"/>
            </HBox>

            <!-- Historique -->
            <VBox spacing="16" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:20;">
                <Label text="Historique des mouvements" style="-fx-font-size:18; -fx-font-weight:bold;"/>

                <!-- Movement 1 -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:12; -fx-background-color:#f9f9f9; -fx-background-radius:8;">
                    <Label text="⬆" style="-fx-background-color:#d4edda; -fx-padding:8; -fx-background-radius:50; -fx-font-size:16;"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Vis M6×20" style="-fx-font-weight:bold; -fx-font-size:14;"/>
                        <Label text="CMD-2024-001 • 15/01/2024 14:30" style="-fx-text-fill:#666666; -fx-font-size:12;"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="+200" style="-fx-text-fill:#28a745; -fx-font-weight:bold; -fx-font-size:16;"/>
                        <Label text="Admin" style="-fx-text-fill:#666666; -fx-font-size:11;"/>
                    </VBox>
                </HBox>

                <!-- Movement 2 -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:12; -fx-background-color:#f9f9f9; -fx-background-radius:8;">
                    <Label text="⬇" style="-fx-background-color:#fff3cd; -fx-padding:8; -fx-background-radius:50; -fx-font-size:16;"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Écrous M8" style="-fx-font-weight:bold; -fx-font-size:14;"/>
                        <Label text="PROD-2024-045 • 15/01/2024 10:15" style="-fx-text-fill:#666666; -fx-font-size:12;"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="-50" style="-fx-text-fill:#ffc107; -fx-font-weight:bold; -fx-font-size:16;"/>
                        <Label text="Admin" style="-fx-text-fill:#666666; -fx-font-size:11;"/>
                    </VBox>
                </HBox>

                <!-- Movement 3 -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:12; -fx-background-color:#f9f9f9; -fx-background-radius:8;">
                    <Label text="⬆" style="-fx-background-color:#d4edda; -fx-padding:8; -fx-background-radius:50; -fx-font-size:16;"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Rondelles plates" style="-fx-font-weight:bold; -fx-font-size:14;"/>
                        <Label text="CMD-2024-002 • 14/01/2024 16:45" style="-fx-text-fill:#666666; -fx-font-size:12;"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="+150" style="-fx-text-fill:#28a745; -fx-font-weight:bold; -fx-font-size:16;"/>
                        <Label text="Admin" style="-fx-text-fill:#666666; -fx-font-size:11;"/>
                    </VBox>
                </HBox>

                <!-- Movement 4 -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:12; -fx-background-color:#f9f9f9; -fx-background-radius:8;">
                    <Label text="⬇" style="-fx-background-color:#fff3cd; -fx-padding:8; -fx-background-radius:50; -fx-font-size:16;"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Boulon M10×50" style="-fx-font-weight:bold; -fx-font-size:14;"/>
                        <Label text="PROD-2024-044 • 14/01/2024 11:20" style="-fx-text-fill:#666666; -fx-font-size:12;"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="-30" style="-fx-text-fill:#ffc107; -fx-font-weight:bold; -fx-font-size:16;"/>
                        <Label text="Admin" style="-fx-text-fill:#666666; -fx-font-size:11;"/>
                    </VBox>
                </HBox>

                <!-- Movement 5 -->
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding:12; -fx-background-color:#f9f9f9; -fx-background-radius:8;">
                    <Label text="⬆" style="-fx-background-color:#d4edda; -fx-padding:8; -fx-background-radius:50; -fx-font-size:16;"/>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Joint torique 20mm" style="-fx-font-weight:bold; -fx-font-size:14;"/>
                        <Label text="CMD-2024-003 • 13/01/2024 09:00" style="-fx-text-fill:#666666; -fx-font-size:12;"/>
                    </VBox>
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label text="+100" style="-fx-text-fill:#28a745; -fx-font-weight:bold; -fx-font-size:16;"/>
                        <Label text="Admin" style="-fx-text-fill:#666666; -fx-font-size:11;"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>
</center>
</BorderPane>
