<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controller.controllerResponsableApprovisionnements.GestionStockController"
            prefWidth="1200.0" prefHeight="800.0">

<!-- Sidebar -->
<left>
    <VBox spacing="20.0" alignment="TOP_LEFT" style="-fx-background-color: #f5f7fa; -fx-padding: 20;">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Gestion des stocks" style="-fx-font-weight:bold; -fx-font-size:14;"/>
        </HBox>

        <VBox spacing="8">
            <Label fx:id="lblDashboard" text="Tableau de bord" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblProduits" text="Produits" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblFournisseurs" text="Fournisseurs" style="-fx-cursor: hand; -fx-padding:6 10;"/>
            <Label fx:id="lblCommandes" text="Commandes" style="-fx-cursor: hand; -fx-padding:6 10;"/>

            <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding:6 10; -fx-background-color:#ffffff; -fx-border-radius:6; -fx-background-radius:6;">
                <Label text="Stock" style="-fx-font-weight:bold;"/>
            </HBox>

            <Label fx:id="lblRapports" text="Rapports" style="-fx-cursor: hand; -fx-padding:6 10;"/>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding:10; -fx-background-color: #ffffff; -fx-background-radius:8;">
            <Label text="👤" style="-fx-font-size: 24;"/>
            <VBox>
                <Label text="Responsable Appro" style="-fx-font-weight:bold;"/>
                <Label text="admin@entreprise.fr" style="-fx-font-size:11; -fx-text-fill:gray;"/>
            </VBox>
        </HBox>
    </VBox>
</left>

<!-- Top bar -->
<top>
    <HBox style="-fx-padding:10 20; -fx-background-color: #ffffff; -fx-border-color: transparent transparent #e6e6e6 transparent;"
          alignment="CENTER_LEFT" spacing="10">
        <Label text=" " />
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Responsable des Approvisionnements" style="-fx-text-fill: #777777;"/>
    </HBox>
</top>

<!-- Main content -->
<center>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding:24;">
            <!-- Header -->
            <VBox spacing="6">
                <Label text="Gestion du Stock" style="-fx-font-size:28; -fx-font-weight:bold;"/>
                <Label text="Consultez l'état de vos stocks et suivez les mouvements" style="-fx-text-fill:#666666;"/>
            </VBox>

            <!-- Tabs -->
            <HBox spacing="10">
                <Button text="Inventaire" style="-fx-background-color:#ffffff; -fx-padding:8 16; -fx-background-radius:6; -fx-border-color:#2e86de; -fx-border-radius:6; -fx-font-weight:bold;"/>
                <Button fx:id="btnMouvements" text="Mouvements de stock" onAction="#goToMouvements" style="-fx-background-color:transparent; -fx-padding:8 16; -fx-background-radius:6; -fx-cursor:hand;"/>
            </HBox>

            <!-- Search and filter -->
            <HBox spacing="10">
                <TextField fx:id="searchField" promptText="🔍 Rechercher un produit..."
                           style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:12;" HBox.hgrow="ALWAYS"/>
                <ComboBox promptText="Tous les statuts" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:8 12;"/>
            </HBox>

            <!-- Stock table -->
            <VBox spacing="0" style="-fx-background-color:#ffffff; -fx-background-radius:8; -fx-padding:0;">
                <!-- Table header -->
                <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #e6e6e6 transparent; -fx-border-width:0 0 1 0;">
                    <Label text="Référence" style="-fx-text-fill:#999999; -fx-pref-width:110;"/>
                    <Label text="Produit" style="-fx-text-fill:#999999; -fx-pref-width:150;"/>
                    <Label text="Catégorie" style="-fx-text-fill:#999999; -fx-pref-width:100;"/>
                    <Label text="Stock actuel" style="-fx-text-fill:#999999; -fx-pref-width:100;"/>
                    <Label text="Seuil minimum" style="-fx-text-fill:#999999; -fx-pref-width:110;"/>
                    <Label text="Statut" style="-fx-text-fill:#999999; -fx-pref-width:100;"/>
                    <Label text="Niveau (%)" style="-fx-text-fill:#999999; -fx-pref-width:150;"/>
                </HBox>

                <!-- Stock rows -->
                <VBox fx:id="stockContainer" spacing="0">
                    <!-- Row 1 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="VIS-M6-20" style="-fx-pref-width:110;"/>
                        <Label text="Vis M6×20" style="-fx-pref-width:150;"/>
                        <Label text="Visserie" style="-fx-pref-width:100;"/>
                        <Label text="450 pcs" style="-fx-pref-width:100;"/>
                        <Label text="100 pcs" style="-fx-pref-width:110;"/>
                        <Label text="En stock" style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="5" style="-fx-pref-width:150;">
                            <ProgressBar progress="0.45" prefWidth="100" style="-fx-accent: green;"/>
                            <Label text="450%"/>
                        </HBox>
                    </HBox>

                    <!-- Row 2 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="ECR-M8" style="-fx-pref-width:110;"/>
                        <Label text="Écrous M8" style="-fx-pref-width:150;"/>
                        <Label text="Visserie" style="-fx-pref-width:100;"/>
                        <Label text="12 pcs" style="-fx-pref-width:100;"/>
                        <Label text="100 pcs" style="-fx-pref-width:110;"/>
                        <Label text="Rupture" style="-fx-background-color:#e74c3c; -fx-text-fill:white; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="5" style="-fx-pref-width:150;">
                            <ProgressBar progress="0.12" prefWidth="100" style="-fx-accent: red;"/>
                            <Label text="12%"/>
                        </HBox>
                    </HBox>

                    <!-- Row 3 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="RON-PLAT-10" style="-fx-pref-width:110;"/>
                        <Label text="Rondelles plates" style="-fx-pref-width:150;"/>
                        <Label text="Visserie" style="-fx-pref-width:100;"/>
                        <Label text="75 pcs" style="-fx-pref-width:100;"/>
                        <Label text="150 pcs" style="-fx-pref-width:110;"/>
                        <Label text="Stock faible" style="-fx-background-color:#e8e8e8; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="5" style="-fx-pref-width:150;">
                            <ProgressBar progress="0.5" prefWidth="100" style="-fx-accent: orange;"/>
                            <Label text="50%"/>
                        </HBox>
                    </HBox>

                    <!-- Row 4 -->
                    <HBox spacing="10" style="-fx-padding:16; -fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width:0 0 1 0;">
                        <Label text="BOU-M10-50" style="-fx-pref-width:110;"/>
                        <Label text="Boulon M10×50" style="-fx-pref-width:150;"/>
                        <Label text="Visserie" style="-fx-pref-width:100;"/>
                        <Label text="280 pcs" style="-fx-pref-width:100;"/>
                        <Label text="80 pcs" style="-fx-pref-width:110;"/>
                        <Label text="En stock" style="-fx-background-color:#2e86de; -fx-text-fill:white; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="5" style="-fx-pref-width:150;">
                            <ProgressBar progress="0.35" prefWidth="100" style="-fx-accent: green;"/>
                            <Label text="350%"/>
                        </HBox>
                    </HBox>

                    <!-- Row 5 -->
                    <HBox spacing="10" style="-fx-padding:16;">
                        <Label text="JNT-TOR-20" style="-fx-pref-width:110;"/>
                        <Label text="Joint torique 20mm" style="-fx-pref-width:150;"/>
                        <Label text="Joints" style="-fx-pref-width:100;"/>
                        <Label text="15 pcs" style="-fx-pref-width:100;"/>
                        <Label text="50 pcs" style="-fx-pref-width:110;"/>
                        <Label text="Rupture" style="-fx-background-color:#e74c3c; -fx-text-fill:white; -fx-padding:4 8; -fx-background-radius:6; -fx-pref-width:100;"/>
                        <HBox spacing="5" style="-fx-pref-width:150;">
                            <ProgressBar progress="0.3" prefWidth="100" style="-fx-accent: red;"/>
                            <Label text="30%"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</center>
</BorderPane>
