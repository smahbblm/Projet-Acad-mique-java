<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controler.RapportIn"
            stylesheets="@../../CSS/rapport.css"
            prefWidth="1600" prefHeight="700"
            styleClass="rapport-container">


        <fx:include source="menu.fxml"
                    AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0" />

    <ScrollPane  AnchorPane.leftAnchor="280" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0"  AnchorPane.topAnchor="0"
                 fitToWidth="true"  styleClass="rapport-scrollpane">


        <VBox spacing="20" styleClass="rapport-content-wrapper" fillWidth="true">

            <!-- FORMULAIRE DE GÉNÉRATION (visible au début) -->
            <VBox fx:id="formulaireSection" spacing="5" alignment="CENTER" styleClass="form-container">
                <Label text="Générer un Rapport" styleClass="form-title"/>


                    <Label text="Type :"  styleClass="form-label"/>
                    <TextField fx:id="typeField" promptText="Type de rapport"/>

                    <Label text="Date De :"  styleClass="form-label"/>
                    <DatePicker fx:id="dateDePicker" />

                    <Label text="Date A :"  styleClass="form-label"/>
                    <DatePicker fx:id="dateAPicker"  />

                    <Label text="Inventaire :"  styleClass="form-label" />
                    <ComboBox fx:id="inventaireCombo" prefWidth="280"/>

                <HBox spacing="20" alignment="CENTER">
                    <Button text="Générer" fx:id="btnGenerer" styleClass="btn-generer" onAction="#GenererRapport"/>
                    <Button text="Annuler" fx:id="btnAnnuler" styleClass="btn-annuler"/>
                </HBox>
            </VBox>

            <VBox fx:id="affichageSection"
                  styleClass="rapport-main-vbox"
                  visible="false"
                  managed="false"
                  maxWidth="Infinity"
                  fillWidth="true"
                  VBox.vgrow="ALWAYS">

                <!-- VBox qui contient tout le contenu à mettre dans le PDF -->
                <VBox fx:id="rapportContenu" spacing="10">
                    <!-- En-tête -->
                    <HBox styleClass="rapport-header-box">
                        <Label text="Rapport d'inventaire" styleClass="rapport-titre-principal"/>
                    </HBox>

                    <Separator styleClass="rapport-separateur"/>

                    <!-- Section informations -->
                    <VBox styleClass="rapport-info-section">
                        <Label fx:id="type" text="Type: Inventaire Complet" styleClass="rapport-info-label"/>
                        <Label fx:id="dateGe" text="Date de génération: 23/12/2025" styleClass="rapport-info-label"/>
                        <Label fx:id="periode" text="Période: Du 01/11/2025 - AU 23/11/2025" styleClass="rapport-info-label"/>
                    </VBox>

                    <!-- Section tableau produits -->
                    <VBox styleClass="rapport-section-produits">
                        <HBox styleClass="rapport-section-header">
                            <ImageView styleClass="rapport-section-icon" preserveRatio="true" fitWidth="20" fitHeight="20">
                                <Image url="@Img/ready-stock.png"/>
                            </ImageView>
                            <Label text="Liste des produits inventoriés" styleClass="rapport-section-titre"/>
                        </HBox>

                        <TableView fx:id="TableProduit" styleClass="rapport-table-produits" prefHeight="250">
                            <columns>
                                <TableColumn fx:id="colProduit" text="Produit" prefWidth="150"/>
                                <TableColumn fx:id="colQtéSys" text="Qté Système" prefWidth="120"/>
                                <TableColumn fx:id="colQtéRel" text="Qté Réelle" prefWidth="120"/>
                                <TableColumn fx:id="colEcart" text="Écart" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Section observations -->
                    <VBox styleClass="rapport-section-observations">
                        <HBox styleClass="rapport-observations-header">
                            <ImageView styleClass="rapport-section-icon" preserveRatio="true" fitHeight="15" fitWidth="15">
                                <Image url="@Img/chat.png"/>
                            </ImageView>
                            <Label text="Observations du Magasinier" styleClass="rapport-section-titre"/>
                        </HBox>
                        <TextArea fx:id="description" styleClass="rapport-observations-textarea" wrapText="true"
                                  text="Les écarts sur le riz et la farine sont probablement dus à des erreurs de saisie lors des dernières sorties. Je recommande de renforcer les contrôles sur les bons de sortie et de réorganiser la zone de stockage des produits fragiles."/>
                    </VBox>

                    <!-- Statistiques -->
                    <VBox styleClass="rapport-stats-container">
                        <HBox styleClass="rapport-stats-icon-box" spacing="10">
                            <ImageView styleClass="rapport-stats-icon" preserveRatio="true" fitHeight="25" fitWidth="25">
                                <Image url="@Img/rising.png"/>
                            </ImageView>
                            <Label text="Statistique" style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:#1B3C53"/>
                        </HBox>

                        <HBox styleClass="rapport-stats-row">
                            <VBox styleClass="rapport-stat-box">
                                <Label fx:id="manquantsLabel" text="3" styleClass="rapport-stat-nombre rapport-stat-nombre-manquants"/>
                                <Label text="Manquants" styleClass="rapport-stat-label"/>
                            </VBox>

                            <VBox styleClass="rapport-stat-box">
                                <Label fx:id="excedentsLabel" text="8" styleClass="rapport-stat-nombre rapport-stat-nombre-excedents"/>
                                <Label text="Excédents" styleClass="rapport-stat-label"/>
                            </VBox>

                            <VBox styleClass="rapport-stat-box">
                                <Label fx:id="conformesLabel" text="12" styleClass="rapport-stat-nombre rapport-stat-nombre-conformes"/>
                                <Label text="Conformes" styleClass="rapport-stat-label"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <Separator styleClass="rapport-separateur"/>

                    <!-- Section signatures -->
                    <HBox styleClass="rapport-signatures-section">
                        <VBox styleClass="rapport-signature-box">
                            <Label text="Réalisée par :" styleClass="rapport-signature-titre"/>
                            <Separator styleClass="rapport-signature-separateur"/>
                            <Label text="Date et Signature" styleClass="rapport-signature-label"/>
                        </VBox>

                        <VBox styleClass="rapport-signature-box">
                            <Label text="Validé par :" styleClass="rapport-signature-titre"/>
                            <Separator styleClass="rapport-signature-separateur"/>
                            <Label text="Date et Signature" styleClass="rapport-signature-label"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Boutons en dehors du VBox du rapport pour qu’ils n’apparaissent pas dans le PDF -->
                <HBox styleClass="rapport-boutons-section" spacing="10">
                    <Button text="Imprimer" styleClass="rapport-btn-imprimer" onAction="#genererPdfRapport">
                        <graphic>
                            <HBox>
                                <ImageView styleClass="rapport-btn-icon" preserveRatio="true" fitHeight="15" fitWidth="15">
                                    <Image url="@Img/printer.png"/>
                                </ImageView>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button text="Retour" fx:id="btnRetour" styleClass="rapport-btn-annuler"/>
                </HBox>

            </VBox>

        </VBox>
    </ScrollPane>
</AnchorPane>