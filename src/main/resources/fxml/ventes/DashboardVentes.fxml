<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.controller.VentesController"
            style="-fx-background-color: #f5f5f5;">

    <!-- En-tête -->
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 15;" spacing="20" alignment="CENTER_LEFT">
            <Label text="💼 Dashboard Ventes"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUtilisateurNom" text="Utilisateur"
                   style="-fx-text-fill: white; -fx-font-size: 14px;"/>
            <Button fx:id="btnDeconnexion" text="Déconnexion"
                    onAction="#handleDeconnexion"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 15;"/>
        </HBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <ScrollPane style="-fx-background-color: #f5f5f5; -fx-padding: 0; -fx-border-style: none;">
            <VBox spacing="15" style="-fx-padding: 20;">

                <!-- Cartes statistiques -->
                <HBox spacing="15">
                    <VBox style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-color: white; -fx-padding: 15;" spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="👥 Clients actifs" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="lblClientsActifs" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    </VBox>
                    <VBox style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-color: white; -fx-padding: 15;" spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="📦 Livraisons en attente" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="lblLivraisonsAttente" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                    </VBox>
                    <VBox style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-color: white; -fx-padding: 15;" spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="✅ Livraisons livrées" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="lblLivraisonsLivrees" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>
                    <VBox style="-fx-border-color: #ddd; -fx-border-radius: 5; -fx-background-color: white; -fx-padding: 15;" spacing="10" HBox.hgrow="ALWAYS">
                        <Label text="💰 Factures impayées" style="-fx-font-size: 12; -fx-text-fill: #666;"/>
                        <Label fx:id="lblFacturesImpayees" text="0" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    </VBox>
                </HBox>

                <!-- Section actions principales -->
                <Separator style="-fx-padding: 0;"/>

                <Label text="Actions Principales" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <GridPane hgap="10" vgap="10">
                    <Button text="👥 Gérer Clients" onAction="#handleGererClients"
                            style="-fx-padding: 12 20; -fx-font-size: 13; -fx-background-color: #3498db; -fx-text-fill: white;"
                            GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Button text="📦 Créer Bon de Livraison" onAction="#handleCreerBonLivraison"
                            style="-fx-padding: 12 20; -fx-font-size: 13; -fx-background-color: #27ae60; -fx-text-fill: white;"
                            GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Button text="💰 Gérer Factures" onAction="#handleGererFactures"
                            style="-fx-padding: 12 20; -fx-font-size: 13; -fx-background-color: #9b59b6; -fx-text-fill: white;"
                            GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Button text="🔍 Consulter Disponibilité" onAction="#handleConsulterDisponibilite"
                            style="-fx-padding: 12 20; -fx-font-size: 13; -fx-background-color: #e67e22; -fx-text-fill: white;"
                            GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                </GridPane>

                <!-- Section alertes -->
                <Separator style="-fx-padding: 0;"/>

                <Label text="Alertes et Notifications" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <ListView fx:id="listAlertes" prefHeight="150" style="-fx-font-size: 12; -fx-padding: 10;"/>

                <!-- Section dernières livraisons -->
                <Separator style="-fx-padding: 0;"/>

                <Label text="Dernières Livraisons" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <TableView fx:id="tableLivraisons" prefHeight="200" style="-fx-font-size: 11;">
                    <columns>
                        <TableColumn fx:id="colNumero" text="Numéro" prefWidth="80"/>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="colClient" text="Client" prefWidth="150"/>
                        <TableColumn fx:id="colAdresse" text="Adresse" prefWidth="200"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Pied de page -->
    <bottom>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 10;" spacing="10" alignment="CENTER_LEFT">
            <Label fx:id="lblDateHeure" text="" style="-fx-text-fill: white; -fx-font-size: 11;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="📊 Rapport Ventes Détaillé" onAction="#handleGenererRapportVentesDetaille"
                    style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-padding: 5 10;"/>
            <Button text="↩️ Retour" onAction="#handleRetour"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 5 10;"/>
        </HBox>
    </bottom>
</BorderPane>

