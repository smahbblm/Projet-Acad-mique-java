<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.controller.GestionLivraisonsController"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="📦 Gestion des Bons de Livraison"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-padding: 15;">

            <!-- Filtres -->
            <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #ddd;">
                <TextField fx:id="txtRecherche" promptText="Recherche (numéro, client, adresse)" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="comboStatut" promptText="Statut" prefWidth="160"/>
                <Button text="🔍 Filtrer" onAction="#handleFiltrer" style="-fx-background-color:#3498db;-fx-text-fill:white;"/>
                <Button text="♻️ Réinitialiser" onAction="#handleReinitialiser"/>
            </HBox>

            <!-- Tableau des bons de livraison -->
            <TableView fx:id="tableLivraisons" prefHeight="260" style="-fx-font-size:11;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNumero" text="Numéro" prefWidth="110"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="colClient" text="Client" prefWidth="160"/>
                    <TableColumn fx:id="colAdresse" text="Adresse Livraison" prefWidth="220"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Lignes du bon sélectionné -->
            <TitledPane text="Lignes du Bon de Livraison sélectionné" expanded="true" style="-fx-font-size:12;">
                <VBox spacing="8" style="-fx-padding:10;">
                    <HBox spacing="8">
                        <Label text="Client:" style="-fx-font-weight:bold;"/>
                        <Label fx:id="lblClientSelection" text="-"/>
                        <Label text="Numéro:" style="-fx-font-weight:bold;"/>
                        <Label fx:id="lblNumeroSelection" text="-"/>
                        <Label text="Statut:" style="-fx-font-weight:bold;"/>
                        <Label fx:id="lblStatutSelection" text="-"/>
                    </HBox>
                    <TableView fx:id="tableLignes" prefHeight="180" style="-fx-font-size:11;">
                        <columns>
                            <TableColumn fx:id="colProdRef" text="Réf" prefWidth="90"/>
                            <TableColumn fx:id="colProdDes" text="Désignation" prefWidth="180"/>
                            <TableColumn fx:id="colQuantite" text="Qté" prefWidth="70"/>
                            <TableColumn fx:id="colPrix" text="Prix U" prefWidth="80"/>
                            <TableColumn fx:id="colSousTotal" text="Sous-total" prefWidth="90"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Total HT:" style="-fx-font-weight:bold;"/>
                        <Label fx:id="lblTotalHT" text="0.00"/>
                        <Label text="Total TTC (TVA 20%):" style="-fx-font-weight:bold;"/>
                        <Label fx:id="lblTotalTTC" text="0.00"/>
                    </HBox>
                </VBox>
            </TitledPane>

            <!-- Actions -->
            <HBox spacing="8" style="-fx-background-color:white; -fx-padding:10; -fx-border-color:#ddd;" alignment="CENTER_LEFT">
                <Button text="➕ Nouveau BL" onAction="#handleNouveau" style="-fx-background-color:#27ae60; -fx-text-fill:white;"/>
                <Button text="📝 Ajouter Ligne" onAction="#handleAjouterLigne"/>
                <Button text="✔️ Valider" onAction="#handleValider" style="-fx-background-color:#2980b9; -fx-text-fill:white;"/>
                <Button text="📤 Transmettre" onAction="#handleTransmettre" style="-fx-background-color:#8e44ad; -fx-text-fill:white;"/>
                <Button text="🚚 Marquer Livrée" onAction="#handleMarquerLivree" style="-fx-background-color:#16a085; -fx-text-fill:white;"/>
                <Button text="💰 Générer Facture" onAction="#handleGenererFacture" style="-fx-background-color:#9b59b6; -fx-text-fill:white;"/>
                <Button text="❌ Annuler" onAction="#handleAnnuler" style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCompteur" text="0 BL" style="-fx-text-fill:#555;"/>
                <Button text="↩️ Retour" onAction="#handleRetour" style="-fx-background-color:#95a5a6; -fx-text-fill:white;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
