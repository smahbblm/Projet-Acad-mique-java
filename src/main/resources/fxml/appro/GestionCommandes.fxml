<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.controller.GestionCommandesController"
            style="-fx-background-color: #f5f5f5;">

    <!-- En-tête -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="📋 Gestion des Bons de Commande"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <VBox spacing="10" style="-fx-padding: 20;">

            <!-- Barre de filtres -->
            <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #ddd;">
                <TextField fx:id="txtNumero" promptText="Numéro commande..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="comboStatut" promptText="Statut" prefWidth="150"/>
                <ComboBox fx:id="comboFournisseur" promptText="Fournisseur" prefWidth="150"/>
                <Button text="🔍 Chercher" onAction="#handleRecherche"
                        style="-fx-padding: 8 15; -fx-font-size: 12;"/>
            </HBox>

            <!-- Tableau des commandes -->
            <TableView fx:id="tableCommandes" VBox.vgrow="ALWAYS" style="-fx-font-size: 11;">
                <columns>
                    <TableColumn fx:id="colNumero" text="Numéro" prefWidth="80"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="colFournisseur" text="Fournisseur" prefWidth="150"/>
                    <TableColumn fx:id="colMontant" text="Montant" prefWidth="100"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                    <TableColumn fx:id="colUtilisateur" text="Créateur" prefWidth="120"/>
                </columns>
            </TableView>

            <!-- Section détails commande -->
            <Separator style="-fx-padding: 0;"/>

            <Label text="Détails de la Commande" style="-fx-font-size: 14; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #ddd;">
                <Label text="Fournisseur:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="comboFournisseurNew" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Date Livraison:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <DatePicker fx:id="dateLivraison" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Notes:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextArea fx:id="txtNotes" prefHeight="80" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <!-- Boutons d'action -->
            <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #ddd;">
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCreer" text="➕ Créer" onAction="#handleCreer"
                        style="-fx-padding: 8 15; -fx-background-color: #27ae60; -fx-text-fill: white;"/>
                <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#handleModifier"
                        style="-fx-padding: 8 15; -fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Button fx:id="btnSupprimer" text="🗑️ Supprimer" onAction="#handleSupprimer"
                        style="-fx-padding: 8 15; -fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                <Button fx:id="btnRetour" text="↩️ Retour" onAction="#handleRetour"
                        style="-fx-padding: 8 15; -fx-background-color: #95a5a6; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
