<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controller.Dashboard_Administrateur.GenerateReportController"
            prefHeight="400.0" prefWidth="600.0">

    <VBox spacing="20" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          style="-fx-padding:20;">

        <!-- TITRE -->
        <Label text="Générer un Rapport"
               style="-fx-font-size:28; -fx-font-weight:bold; -fx-text-fill:#2d3748;" />

        <Region prefHeight="10"/>

        <!-- TYPE RAPPORT -->
        <VBox spacing="5">
            <Label text="Type de Rapport :" style="-fx-font-size:18; -fx-font-weight:bold;" />
            <ComboBox fx:id="reportType" style="-fx-font-size:14px;" prefWidth="350" promptText="Sélectionner un type"/>
        </VBox>

        <!-- DATES -->
        <HBox spacing="40">
            <VBox spacing="5">
                <Label text="Date Début" style="-fx-font-size:18; -fx-font-weight:bold;" />
                <DatePicker fx:id="startDate" style="-fx-font-size:14px;" />
            </VBox>

            <VBox spacing="5">
                <Label text="Date Fin" style="-fx-font-size:18; -fx-font-weight:bold;" />
                <DatePicker fx:id="endDate" style="-fx-font-size:14px; "/>
            </VBox>
        </HBox>

        <!-- FORMAT -->
        <VBox spacing="5">
            <Label text="Format :" style="-fx-font-size:18; -fx-font-weight:bold;" />
            <ComboBox fx:id="formatBox" style="-fx-font-size:14px; " prefWidth="200" promptText="Choisir un format"/>
        </VBox>

        <!-- BOUTON -->
        <Button fx:id="generateButton"
                text="Générer le Rapport"
                prefWidth="250"
                style="-fx-background-color:#2b6cb0; -fx-text-fill:white;
                       -fx-font-size:17; -fx-padding:12 20; -fx-background-radius:10;" />

        <!-- STATUT -->
        <Label fx:id="statusLabel" text="" style="-fx-font-size:14;" />

    </VBox>
</AnchorPane>
