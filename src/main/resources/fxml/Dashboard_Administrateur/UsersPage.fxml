<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21.0.0"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.stock.Controller.Dashboard_Administrateur.UsersPageController"
           style="-fx-background-color:#f4f6f8; -fx-padding:20;">

    <HBox spacing="0" alignment="CENTER">
        <VBox spacing="15" alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="900"
              style="-fx-background-color: transparent;">

            <!-- En-tête + Bouton Ajouter -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Gestion des comptes utilisateurs"
                       style="-fx-font-size:28; -fx-font-weight:bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Ajouter un utilisateur" onAction="#handleShowAddUserPage"
                        style="-fx-background-color:#4361ee; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:14px;"
                        prefWidth="200" prefHeight="40"/>
            </HBox>

            <Region prefHeight="10"/>

            <!-- Barre de recherche -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="Rechercher:" style="-fx-font-weight:bold; -fx-font-size:14px;"/>
                <TextField fx:id="searchField" promptText="Nom, prénom, email..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-weight:bold; -fx-font-size:14px;
                                  -fx-padding:5 10; -fx-background-radius:5;
                                  -fx-border-radius:5; -fx-border-color:#cbd5e0;"/>
            </HBox>

            <Region prefHeight="10"/>

            <!-- Table des utilisateurs -->
            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS"
                       prefHeight="600"
                       style="-fx-background-color:white; -fx-background-radius:8; -fx-font-size:14px;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nomColumn" text="Nom" prefWidth="100"/>
                    <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="100"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="roleColumn" text="Rôle" prefWidth="170"/>
                    <TableColumn fx:id="actifColumn" text="Actif" prefWidth="90"/>
                    <TableColumn fx:id="actionColumn" text="Actions" prefWidth="170"/>
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

        </VBox>
    </HBox>

</StackPane>
