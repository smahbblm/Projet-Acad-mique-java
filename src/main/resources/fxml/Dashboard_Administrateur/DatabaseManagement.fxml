<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.Controller.Dashboard_Administrateur.DatabaseManagementController"
            prefHeight="400.0" prefWidth="600.0">

    <VBox spacing="20" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          style="-fx-padding:20;">

        <Label text="Gestion de la Base de Données"
               style="-fx-font-size:28; -fx-font-weight:bold; -fx-text-fill:#2d3748;" />

        <!-- Section Sauvegarde -->
        <VBox spacing="10">
            <Label text="Sauvegarder la BDD" style="-fx-font-size:18; -fx-font-weight:bold;"/>
            <Button fx:id="backupButton" text="Sauvegarder"/>
            <Label fx:id="backupStatus" text=""/>
        </VBox>

        <!-- Section Restauration -->
        <VBox spacing="10">
            <Label text="Restaurer la BDD" style="-fx-font-size:18; -fx-font-weight:bold;"/>
            <Button fx:id="chooseFileButton" text="Choisir un fichier"/>
            <Button fx:id="restoreButton" text="Restaurer"/>
            <Label fx:id="restoreStatus" text=""/>
        </VBox>

    </VBox>


</AnchorPane>
