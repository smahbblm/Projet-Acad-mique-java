<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.stock.controller.RapportsController"
            style="-fx-background-color: #f5f5f5;">

    <!-- En-tête -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="📄 Génération de Rapports"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Contenu principal -->
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">

            <!-- Panneau gauche - Génération -->
            <VBox spacing="15" prefWidth="300" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                <Label text="🔧 Générer un Rapport" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                <!-- Type de rapport -->
                <VBox spacing="5">
                    <Label text="Type de rapport:" style="-fx-font-size: 12px;"/>
                    <ComboBox fx:id="comboTypeRapport" promptText="Sélectionner un type" prefWidth="250"/>
                </VBox>

                <!-- Période -->
                <VBox spacing="5">
                    <Label text="Date de début:" style="-fx-font-size: 12px;"/>
                    <DatePicker fx:id="dateDebut" prefWidth="250"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Date de fin:" style="-fx-font-size: 12px;"/>
                    <DatePicker fx:id="dateFin" prefWidth="250"/>
                </VBox>

                <!-- Boutons -->
                <VBox spacing="10" style="-fx-padding: 10 0 0 0;">
                    <Button fx:id="btnGenerer" text="📊 Générer Rapport"
                            onAction="#handleGenerer"
                            style="-fx-padding: 10 20; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-max-width: Infinity;"/>
                    <Button fx:id="btnExporter" text="💾 Exporter"
                            onAction="#handleExporter"
                            style="-fx-padding: 10 20; -fx-background-color: #3498db; -fx-text-fill: white; -fx-max-width: Infinity;"/>
                </VBox>
            </VBox>

            <!-- Panneau droit - Contenu -->
            <VBox spacing="15" HBox.hgrow="ALWAYS">

                <!-- Liste des rapports générés -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;">
                    <Label text="📋 Rapports Générés" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                    <TableView fx:id="tableRapports" prefHeight="200" style="-fx-font-size: 11;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                            <TableColumn fx:id="colDateGeneration" text="Date" prefWidth="100"/>
                            <TableColumn fx:id="colPeriode" text="Période" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Contenu du rapport -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;" VBox.vgrow="ALWAYS">
                    <Label fx:id="lblTitreRapport" text="Sélectionnez un rapport ou générez-en un nouveau"
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

                    <TextArea fx:id="txtContenuRapport" prefHeight="300" editable="false"
                             style="-fx-font-family: 'Courier New'; -fx-font-size: 11;"/>
                </VBox>
            </VBox>
        </HBox>
    </center>

    <!-- Pied de page -->
    <bottom>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 15;" spacing="20" alignment="CENTER">
            <Button fx:id="btnRetour" text="↩️ Retour au Dashboard"
                    onAction="#handleRetour"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 20;"/>
        </HBox>
    </bottom>
</BorderPane>
